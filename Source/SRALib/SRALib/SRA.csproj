<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SRALib targets RimWorld 1.7 only.
    RimWorld 1.6 is intentionally frozen in 1.6/Assemblies and is not rebuilt.

    RimWorld 1.7 uses CoreCLR/net10 and has a different layout from 1.6:
    game assemblies are in the game root and UnityEngine types are provided by
    UnityStubs.dll. Waylith redirects UnityEngine assembly names at runtime.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SRALib</AssemblyName>
    <RootNamespace>SRA</RootNamespace>
    <OutputType>Library</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <UseAppHost>false</UseAppHost>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS1591;MSB3277</NoWarn>

    <ModRoot Condition="'$(ModRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..'))</ModRoot>
    <RimWorldDir Condition="'$(RimWorldDir)' == '' and '$(RimWorldRoot)' != ''">$([System.IO.Path]::GetFullPath('$(RimWorldRoot)'))</RimWorldDir>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$([System.IO.Path]::GetFullPath('$(ModRoot)\..\..'))</RimWorldDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(RimWorldDir)</ManagedDir>
    <SteamAppsDir Condition="'$(SteamAppsDir)' == ''">$([System.IO.Path]::GetFullPath('$(RimWorldDir)\..\..'))</SteamAppsDir>
    <WorkshopDir Condition="'$(WorkshopDir)' == ''">$(SteamAppsDir)\workshop\content\294100</WorkshopDir>
    <HarmonyAssemblyDir Condition="'$(HarmonyAssemblyDir)' == ''">$(WorkshopDir)\2009463077\1.7\Assemblies</HarmonyAssemblyDir>
    <HarmonyAssembly Condition="'$(HarmonyAssembly)' == ''">$(HarmonyAssemblyDir)\0Harmony.dll</HarmonyAssembly>
    <ModAssembliesDir Condition="'$(ModAssembliesDir)' == ''">$(ModRoot)\1.7\Assemblies</ModAssembliesDir>
    <OutputPath>$(ModAssembliesDir)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The legacy root copy is not part of the old project; keep Properties\AssemblyInfo.cs. -->
    <Compile Remove="AssemblyInfo.cs" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(ManagedDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(ManagedDir)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimWorld">
      <HintPath>$(ManagedDir)\RimWorld.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HarmonyMod">
      <HintPath>$(HarmonyAssemblyDir)\HarmonyMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="SRALibValidateGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')"
           Text="找不到 1.7 的 Assembly-CSharp.dll：$(ManagedDir)\Assembly-CSharp.dll。1.7 程序集位于 RimWorld 游戏根目录。" />
    <Error Condition="!Exists('$(ManagedDir)\UnityStubs.dll')"
           Text="找不到 1.7 的 UnityStubs.dll：$(ManagedDir)\UnityStubs.dll。" />
    <Error Condition="!Exists('$(ManagedDir)\Waylith.dll')"
           Text="找不到 1.7 的 Waylith.dll：$(ManagedDir)\Waylith.dll。" />
    <Error Condition="!Exists('$(ManagedDir)\RimWorld.dll')"
           Text="找不到 1.7 的 RimWorld.dll：$(ManagedDir)\RimWorld.dll。" />
    <Error Condition="!Exists('$(HarmonyAssembly)')"
           Text="找不到 1.7 的 0Harmony.dll：$(HarmonyAssembly)。" />
  </Target>
</Project>
